<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.VLW" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/vlw_green</item>
        <item name="colorOnPrimary">@color/vlw_white</item>
        <item name="android:statusBarColor">@color/vlw_cream</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/vlw_cream</item>
    </style>
    <style name="Theme.VLW.Splash" parent="Theme.VLW">
        <item name="android:windowBackground">@color/vlw_splash_bg</item>
        <item name="android:statusBarColor">@color/vlw_splash_bg</item>
        <item name="android:navigationBarColor">@color/vlw_splash_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
